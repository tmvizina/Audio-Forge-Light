# Required. Your hosted Fish Audio TTS API key.
FISH_API_KEY=

# Optional. Fish model id; defaults to s2.1-pro-free if unset.
FISH_MODEL=

# Optional. Only needed for --tagger claude (or --tagger auto resolving to claude).
ANTHROPIC_API_KEY=

# Optional. Only needed for --tagger codex (or --tagger auto resolving to codex).
OPENAI_API_KEY=

# Required only for --tagger codex. No default — codex tagging must not silently
# run against a model you didn't choose, so this is left blank on purpose.
OPENAI_TAG_MODEL=
